# Copy this file to `.env` and adjust as needed. `.env` is git-ignored —
# never commit real secrets. Neither variable is required for local dev;
# the app has sane defaults for both.

# Liberty Rider's Firebase web API key, used to exchange your email/password
# for a Firebase ID token (see firebase_refresh.py). The app already ships
# a working default captured from Liberty Rider's own site (Firebase web
# API keys are public by design — they identify the project, not a secret).
# You only need to set this if that key ever rotates and login starts
# failing.
# LIBERTY_RIDER_FIREBASE_API_KEY=

# Set to 1 to mark the session cookie as Secure, so browsers only ever send
# it over HTTPS. Only matters once you're running behind HTTPS (any real
# deployment); leave unset for local http://127.0.0.1 development, since a
# Secure cookie would otherwise be silently dropped over plain HTTP.
# COOKIE_SECURE=1
